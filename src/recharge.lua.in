-- Recharge Priority - @VARIANT_LABEL@
-- RENDERED FILE - do not edit; edit src/recharge.lua.in and src/patches.tsv
-- and run make release.
--
-- Updated by SavageCore
--
-- What it does: the game spends the first recharge fuel it can find in a
-- technology's ChargeBy list. This rewrites that order so Ion Batteries and
-- Life Support Gel come first, and the raw substances stay behind them as
-- fallbacks. The Terrain Manipulator ships no list at all, only a substance
-- category, so its option writes the list: Silicate Powder first, the three
-- ferrites behind it.
--
-- The list slots are in src/patches.tsv, which also drives the verify step,
-- so a slot can never be patched without also being checked. MXML_CHANGE_TABLE
-- is a LIST of change blocks even when there is only one, so the block list
-- is wrapped in an outer table. Handing AMUMSS a bare block instead makes it
-- report "MXML_CHANGE_TABLE does not contain any usable TABLE", make 0
-- changes, and ship nothing.

local ModName     = "Recharge Priority"
local ModAuthor   = "SavageCore"
local GameVersion = "v7.10"

NMS_MOD_DEFINITION_CONTAINER = {
    ["MOD_FILENAME"]    = ModName.." - @VARIANT_LABEL@.pak",
    ["MOD_DESCRIPTION"] = "@DESC@",
    ["MOD_AUTHOR"]      = ModAuthor,
    ["NMS_VERSION"]     = GameVersion,
    ["MODIFICATIONS"]   =
    {
        {
            ["MBIN_CHANGE_TABLE"] =
            {
@MBINBLOCKS@
            },
        },
    },
}
